# __DOMAIN__ — public statik site (Vite/React). Kaynak: github.com/atonota/agency
# "sites-enabled" düzenindeki Caddy sunucuları içindir (ör. srv01): ortak snippet ve bind kullanmaz,
# sunucudaki diğer sitelerle aynı log biçimini kullanır. Diğer site dosyalarına dokunulmaz.
__DOMAIN__ {
    header {
        -via
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        # Build dosya adlarında hash yok (assets/app.js) → her istekte ETag ile doğrula
        Cache-Control "no-cache"
    }

    root * __BASE__/current
    encode zstd gzip
    try_files {path} /index.html
    file_server

    log {
        output file /var/log/caddy/access_log/__DOMAIN__.log
        format transform `{request>remote_ip} - {user_id} [{ts}] "{request>method} {request>uri} {request>proto}" {status} {size} "{request>headers>Referer>[0]}" "{request>headers>User-Agent>[0]}"` {
            time_format "02/Jan/2006:15:04:05 -0700"
            time_local
        }
    }

    log __DOMAIN__ {
        output file /var/log/caddy/byte_log/__DOMAIN__.log
        format filter {
            wrap json
            level delete
            ts delete
            logger delete
            msg delete
            request delete
            tls delete
            duration delete
            status delete
            resp_headers delete
            bytes_read delete
            user_id delete
        }
    }
}

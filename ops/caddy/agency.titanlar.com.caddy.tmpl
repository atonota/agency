# agency.titanlar.com — public statik site (Vite/React). Kaynak: github.com/atonota/agency
# TLS: titanlar.com ayrı bir DNS zone'u; Cloudflare token'ı gerekmesin diye standart ACME (TLS-ALPN-01, 443) kullanılır.
agency.titanlar.com {
	bind {$PUBLIC_IP}
	import common agency.titanlar.com

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Build dosya adlarında hash yok (assets/app.js) → her istekte ETag ile doğrula
		Cache-Control "no-cache"
	}

	root * __BASE__/current
	encode zstd gzip
	try_files {path} /index.html
	file_server
}
